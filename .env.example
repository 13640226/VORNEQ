# Development defaults
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Production must use a strong secret, DJANGO_DEBUG=false, and explicit hosts.
# ACCOUNT_EMAIL_VERIFICATION=mandatory

# Optional cache. Requires a Redis client dependency before enabling.
# REDIS_URL=redis://localhost:6379/1

# Production email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Saman Kherad <noreply@example.com>

# Optional explicit settings selection
# DJANGO_SETTINGS_MODULE=config.settings.production
