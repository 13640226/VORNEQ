{
  "openapi": "3.1.0",
  "info": {
    "title": "VORNEQ API",
    "version": "1.0.0",
    "description": "Current V1 compatibility contract for VORNEQ's Django-native HTTP API. Discovery endpoints do not imply verification or trust."
  },
  "paths": {
    "/api/search/": {
      "get": {
        "summary": "Unified discovery search",
        "parameters": [
          {"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 200}},
          {"name": "type", "in": "query", "schema": {"type": "string"}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {"200": {"description": "Discovery results"}}
      }
    },
    "/api/verification/product/{id}/": {
      "get": {
        "summary": "Public product verification summary",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Public-safe verification summary"}, "404": {"description": "Product not found or not public"}}
      }
    },
    "/api/verification/library/{id}/": {
      "get": {
        "summary": "Public library-item verification summary",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Public-safe verification summary"}, "404": {"description": "Library item not found or not public"}}
      }
    },
    "/api/reputation/user/{id}/": {
      "get": {
        "summary": "Public contextual reputation list",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Public contextual reputation projection"}, "404": {"description": "User not found"}}
      }
    },
    "/api/reputation/user/{id}/{domain}/{method_code}/": {
      "get": {
        "summary": "Public contextual reputation detail",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}},
          {"name": "domain", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "method_code", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Context-specific public reputation projection"}, "404": {"description": "Context not found"}}
      }
    },
    "/api/reputation/{id}/": {
      "get": {
        "summary": "Authenticated reputation snapshot",
        "security": [{"sessionAuth": []}],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Authenticated reputation snapshot"}, "302": {"description": "Login redirect when unauthenticated"}, "404": {"description": "User not found"}}
      }
    },
    "/api/media/search/text/": {
      "post": {
        "summary": "Experimental text-to-media discovery",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 2000}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}}}}},
        "responses": {"200": {"description": "Similarity results"}, "400": {"description": "Invalid request"}, "503": {"description": "Production embedding provider not configured"}}
      }
    },
    "/api/media/search/image/": {
      "post": {
        "summary": "Experimental image-to-media discovery",
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["image"], "properties": {"image": {"type": "string", "format": "binary"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}}}}},
        "responses": {"200": {"description": "Similarity results"}, "400": {"description": "Invalid request"}, "413": {"description": "Image too large"}, "503": {"description": "Production embedding provider not configured"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionAuth": {"type": "apiKey", "in": "cookie", "name": "sessionid"}
    }
  }
}
